# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database
# SQLite for the prototype. Only user-created state lives here (preferences and
# assistant conversations); meter readings are served from data/raw via the
# ingestion layer. Swap for a PostgreSQL URL when you outgrow it.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./energy_platform.db

# ---------------------------------------------------------------------------
# Tariff  --  CONFIGURATION, NOT MEASUREMENT.
# The dataset contains no tariff information, so every cost the platform reports
# is an estimate derived from these rates and is labelled as one.
# ---------------------------------------------------------------------------
CURRENCY=INR
CURRENCY_SYMBOL=₹
TARIFF_MODE=tou              # flat | tou
DEFAULT_TARIFF_PER_KWH=8
TOU_PEAK_RATE=11
TOU_SHOULDER_RATE=8
TOU_OFFPEAK_RATE=5
TOU_PEAK_HOURS=18,19,20,21,22
TOU_OFFPEAK_HOURS=0,1,2,3,4,5,10,11,12,13,14,15

# ---------------------------------------------------------------------------
# Carbon  --  CONFIGURATION, NOT MEASUREMENT.
# kg CO2e per kWh. Default is the Indian grid average (CEA).
# ---------------------------------------------------------------------------
GRID_EMISSION_FACTOR=0.71
GRID_EMISSION_FACTOR_SOURCE=CEA India grid average (configured default)
GRID_EMISSION_FACTOR_OVERRIDES=Singapore:0.417

# ---------------------------------------------------------------------------
# Weather
# open-meteo needs NO key and is the default. openweather and weatherapi do.
# All provider calls happen server-side; the key never reaches the browser.
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo   # open-meteo | openweather | weatherapi
WEATHER_API_KEY=
WEATHER_CACHE_SECONDS=900
WEATHER_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# LLM  --  optional.
# Without a key the assistant falls back to deterministic, data-grounded answers,
# and the rest of the platform is unaffected.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic        # anthropic | openai | gemini | none
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Optional asset modules  --  all OFF by default.
# This dataset contains no solar, battery or EV measurements. Enabling these
# turns on the interfaces and the optimisation logic; it does not invent readings.
# ALLOW_SIMULATION additionally permits a MODELLED clear-sky solar profile, which
# is tagged `simulated` everywhere it appears and never shown as measured.
# ---------------------------------------------------------------------------
SOLAR_ENABLED=false
SOLAR_CAPACITY_KW=0
BATTERY_ENABLED=false
BATTERY_CAPACITY_KWH=0
BATTERY_RESERVE_PCT=20
BATTERY_MAX_CHARGE_KW=0
BATTERY_MAX_DISCHARGE_KW=0
EV_ENABLED=false
EV_BATTERY_KWH=0
EV_CHARGER_KW=0
ALLOW_SIMULATION=false

# ---------------------------------------------------------------------------
# Demo
# House_4 has the longest history and the only classifier that validates well.
# ---------------------------------------------------------------------------
DEMO_SITE_ID=House_4
